<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Library\DbfPaths.cs" Link="DbfPaths.cs" />
    <Compile Include="..\Library\DbfExecutor.cs" Link="DbfExecutor.cs" />
    <ProjectReference Include="..\Library\HarbourDBF.NET.csproj" />
    <Content Include="fixtures\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\HarbourLibrary\hbdbf.dll" Link="hbdbf.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\HarbourLibrary\hbdbf.dll')" />
  </ItemGroup>
</Project>
